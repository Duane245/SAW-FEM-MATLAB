    value: "10.5281/zenodo.20362278"
    description: "Concept DOI (all versions)"
  - type: doi
    value: "10.5281/zenodo.20635934"
    description: "Version DOI for v0.4.0 (MATLAB)"
keywords:
  - SAW
  - surface-acoustic-wave
  - piezoelectric
  - finite-element
